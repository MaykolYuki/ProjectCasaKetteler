# =========================================================================
# CONFIGURACIÓN LOCAL DE DESARROLLO 
# =========================================================================

# Perfil de Spring (dev o prod)
SPRING_PROFILES_ACTIVE=dev

# Base de datos (Perfil DEV)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=casaKetteler
DB_USERNAME=root
DB_PASSWORD=root

# Configuración de Correo (Gmail)
MAIL_USERNAME=tu_correo_real@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_de_16_digitos

# Seguridad JWT — GENERA EL TUYO, no uses este texto.
# Debe ser largo y aleatorio (mínimo 32 caracteres). Para generar uno:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=REEMPLAZAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA

# Rutas de almacenamiento — usa RUTAS ABSOLUTAS de ESTA computadora, con barras /
# (aquí se guardan las fotos de reconocimiento y los documentos subidos)
APP_STORAGE_PATH=C:/ruta/a/ProjectCasaKetteler/storage
APP_TEMP_PATH=C:/ruta/a/ProjectCasaKetteler/temp

# Orígenes permitidos (CORS). Incluye la IP de esta PC en la red local para que
# el celular pueda conectarse. Reemplaza 192.168.1.100 por la IP real (ipconfig).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8001,capacitor://localhost,http://localhost,http://192.168.1.100:4200,http://192.168.1.100:8001