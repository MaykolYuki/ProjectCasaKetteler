spring.application.name=projectcasaketteler
spring.jackson.time-zone=America/Lima
server.port=8001

# Perfil activo: por defecto 'dev', en producción se define SPRING_PROFILES_ACTIVE=prod
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

# Estrategia de nombres de Hibernate (Mapeo exacto de entidades)
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# Configuración del Pool de conexiones (Hikari)
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.max-lifetime=1800000

# Límites para la subida de archivos/documentos
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=100MB
file.upload-dir=storage

# Servidor de correos (Se alimenta de variables de entorno obligatorias)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Seguridad JWT (Se alimenta de variables de entorno obligatorias)
jwt.secret=${JWT_SECRET}
jwt.expiration=86400000

# Orígenes CORS permitidos (Toma la lista del .env o usa los localhost por defecto)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200,capacitor://localhost,http://localhost}