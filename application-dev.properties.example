# CONFIGURACIÓN DE BASE DE DATOS LOCAL (EJEMPLO)
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:casaKetteler}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:root}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# HIBERNATE / JPA
spring.jpa.generate-ddl=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# RUTAS LOCALES
app.storage.path=${APP_STORAGE_PATH:./storage}
app.temp.path=${APP_TEMP_PATH:./temp}